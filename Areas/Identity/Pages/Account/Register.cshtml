@page
@model RegisterModel
@{ ViewData["Title"] = "Register"; }
<section class="auth-page">
    <div class="auth-card wide">
        <a class="auth-brand" asp-area="" asp-controller="Home" asp-action="Index">SmartCubeMobile</a>
        <div class="eyebrow">CREATE YOUR ACCOUNT</div>
        <h1>Start with SmartCubeMobile.</h1>
        <p class="muted">Create your account and start using SmartCubeMobile.</p>
        <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="All" class="form-error"></div>
            <div class="two-fields">
                <div>
                    <label asp-for="Input.UserName">Username</label>
                    <input asp-for="Input.UserName" class="form-control" autocomplete="username" placeholder="Username" />
                    <span asp-validation-for="Input.UserName" class="validation-message"></span>
                </div>
                <div>
                    <label asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="you@example.com" />
                    <span asp-validation-for="Input.Email" class="validation-message"></span>
                </div>
            </div>
            <label asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Create a password" />
            <span asp-validation-for="Input.Password" class="validation-message"></span>
            <label asp-for="Input.ConfirmPassword">Confirm password</label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Repeat your password" />
            <span asp-validation-for="Input.ConfirmPassword" class="validation-message"></span>
            <button type="submit" class="btn btn-primary full btn-large" style="margin-top:22px">Create account</button>
            <p class="auth-switch">Already registered? <a asp-page="./Login">Login</a></p>
        </form>
        @if (Model.ExternalLogins?.Count > 0)
        {
            <div class="form-info" style="margin-top:20px">External registration services are available below.</div>
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @foreach (var provider in Model.ExternalLogins)
                {
                    <button type="submit" class="btn btn-outline full" style="margin-top:10px" name="provider" value="@provider.Name">@provider.DisplayName</button>
                }
            </form>
        }
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
