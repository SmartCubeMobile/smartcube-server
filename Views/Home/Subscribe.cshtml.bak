@{ ViewData["Title"] = "Subscribe"; }
<section class="page-hero"><div class="container narrow"><div class="eyebrow">SUBSCRIBE</div><h1>Choose the plan that fits you.</h1><p>Simple plans designed to grow with SmartCubeMobile.</p></div></section>
<section class="section"><div class="container pricing-grid"><article class="price-card"><h3>Starter</h3><p class="price">£4.99 <small>/ month</small></p><p>A straightforward starting point.</p><ul><li>✓ Account access</li><li>✓ Financial overview</li><li>✓ Transaction history</li></ul><a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline full">Choose Starter</a></article><article class="price-card featured"><div class="popular">MOST POPULAR</div><h3>Smart</h3><p class="price">£9.99 <small>/ month</small></p><p>More insight and more control.</p><ul><li>✓ Everything in Starter</li><li>✓ Advanced analysis</li><li>✓ Enhanced reporting</li></ul><a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary full">Choose Smart</a></article><article class="price-card"><h3>Professional</h3><p class="price">£19.99 <small>/ month</small></p><p>For users who want the complete experience.</p><ul><li>✓ Everything in Smart</li><li>✓ Advanced features</li><li>✓ Priority support</li></ul><a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline full">Choose Professional</a></article></div></section>
